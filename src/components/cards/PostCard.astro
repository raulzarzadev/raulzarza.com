---
import type { PostCard as Post } from "../../content/site";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---
<a href={post.href} class="group rounded-3xl border border-border/60 bg-card/60 p-6 transition hover:-translate-y-1 hover:border-foreground/40">
  <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">{post.date} · {post.readingTime}</p>
  <h3 class="mt-3 text-lg font-semibold">{post.title}</h3>
  <p class="mt-2 text-sm text-muted-foreground">{post.summary}</p>
</a>
