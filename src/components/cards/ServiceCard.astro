---
import type { ServiceCard as Service } from "../../content/site";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---
<article class="flex flex-col gap-4 rounded-3xl border border-border/60 bg-card/60 p-6">
  <div>
    <h3 class="text-xl font-semibold">{service.title}</h3>
    <p class="mt-2 text-sm text-muted-foreground">{service.description}</p>
  </div>
  <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
    {service.deliverables.map((item) => (
      <span class="rounded-full bg-muted px-3 py-1">{item}</span>
    ))}
  </div>
</article>
