---
import ProjectLogo from "../ProjectLogo.astro";
import type { ProjectCard as Project } from "../../content/site";

interface Props {
  project: Project;
  lang: "es" | "en";
}

const { project, lang } = Astro.props;
---
<a
  href={`/${lang}/projects/${project.slug}`}
  class="group flex flex-col overflow-hidden rounded-3xl border border-border/60 bg-card/60 transition hover:-translate-y-1 hover:border-foreground/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
>
  <div class="relative aspect-[1200/630] overflow-hidden border-b border-border/60 bg-muted">
    <img
      src={project.image} style={project.slug === "migranja" ? "object-position: center top" : undefined}
      alt={project.name}
      width="1200"
      height="630"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-[1.03]"
    />
    <ProjectLogo slug={project.slug} name={project.name} />
  </div>
  <div class="flex flex-1 flex-col p-6">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-xl font-semibold">{project.name}</h3>
    <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
      {project.status}
    </span>
  </div>
  <p class="mt-3 text-sm text-muted-foreground">{project.description}</p>
  <div class="mt-auto flex flex-wrap pt-5 gap-2 text-xs text-muted-foreground">
    {project.stack.map((tech) => (
      <span class="rounded-full bg-muted px-3 py-1" data-tech={tech}>{tech}</span>
    ))}
  </div>
    <span class="mt-6 text-sm font-medium">{lang === "es" ? "Explorar proyecto" : "Explore project"} <span aria-hidden="true">↗</span></span>
  </div>
</a>
