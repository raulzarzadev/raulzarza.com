---
interface Props {
  eyebrow?: string;
  title: string;
  caption?: string;
  alignment?: "left" | "center";
}

const { eyebrow, title, caption, alignment = "left" } = Astro.props;
const alignClass = alignment === "center" ? "text-center" : "text-left";
---
<div class={`space-y-2 ${alignClass}`}>
  {eyebrow && <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>
  {caption && <p class="text-base text-muted-foreground">{caption}</p>}
</div>
