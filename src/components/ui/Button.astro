---
import { buttonVariants, type ButtonVariants } from "./button";
import { cn } from "../../lib/utils";

interface Props extends Partial<ButtonVariants> {
  href?: string;
  class?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const { href, class: className = "", variant, size, ariaLabel, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const attributes = {
  ...rest,
  type: !href ? rest.type ?? "button" : undefined,
  href,
  "aria-label": ariaLabel,
};
const classes = cn(buttonVariants({ variant, size }), className);
---
<component this={Tag} class={classes} {...attributes}>
  <slot />
</component>
