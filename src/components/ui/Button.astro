---
import { buttonVariants, type ButtonVariants } from "./button";
import { cn } from "../../lib/utils";

interface Props extends Partial<ButtonVariants> {
  href?: string;
  class?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  download?: boolean | string;
}

const { href, class: className = "", variant, size, ariaLabel, download, type, ...rest } = Astro.props;
const classes = cn(buttonVariants({ variant, size }), className);
---
{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    {...(download !== undefined && { download: download === true ? "" : download })}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    type={type ?? "button"}
    class={classes}
    aria-label={ariaLabel}
    {...rest}
  >
    <slot />
  </button>
)}
