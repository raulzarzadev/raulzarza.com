---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaBase from "../components/schema/SchemaBase.astro";
import SchemaBreadcrumb from "../components/schema/SchemaBreadcrumb.astro";
import type { Lang, SiteCopy } from "../content/site";

interface Props {
	lang: Lang;
	copy: SiteCopy;
	page?: {
		title?: string;
		description?: string;
	};
}

const { lang, copy, page } = Astro.props;
const pageTitle = page?.title
	? `${page.title} · ${copy.seo.siteName}`
	: copy.seo.siteTitle;
const pageDescription = page?.description ?? copy.seo.description;
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, Astro.site).href;

const alternateLang = lang === "es" ? "en" : "es";
const pathSegments = currentPath.split("/").filter(Boolean);
const pathWithoutLang = pathSegments.slice(1).join("/");
const currentHref = new URL(
	`/${lang}${pathWithoutLang ? `/${pathWithoutLang}` : ""}`,
	Astro.site,
).href;
const alternateHref = new URL(
	`/${alternateLang}${pathWithoutLang ? `/${pathWithoutLang}` : ""}`,
	Astro.site,
).href;
const xDefaultHref = new URL(
	`/es${pathWithoutLang ? `/${pathWithoutLang}` : ""}`,
	Astro.site,
).href;
---
<html lang={lang} class="bg-background text-foreground">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/jpeg" href="/icon.jpg" />
    <link rel="apple-touch-icon" href="/icon.jpg" />

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" hreflang={lang} href={currentHref} />
    <link rel="alternate" hreflang={alternateLang} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={copy.seo.siteName} />
    <meta property="og:image" content={new URL('/icon.jpg', Astro.site).href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL('/icon.jpg', Astro.site).href} />

    <!-- Structured Data -->
    <SchemaBase
      lang={lang}
      siteName={copy.seo.siteName}
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      currentUrl={currentUrl}
    />
    <SchemaBreadcrumb
      lang={lang}
      currentPath={currentPath}
      pageTitle={page?.title}
    />

    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme') ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <Header lang={lang} copy={copy} currentPath={currentPath} />
    <main class="mx-auto flex w-full max-w-5xl flex-col gap-24 px-6 py-16">
      <slot />
    </main>
    <Footer lang={lang} copy={copy} />
  </body>
</html>
