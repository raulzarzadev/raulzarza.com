---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang, SiteCopy } from "../content/site";

interface Props {
  lang: Lang;
  copy: SiteCopy;
  page?: {
    title?: string;
    description?: string;
  };
}

const { lang, copy, page } = Astro.props;
const pageTitle = page?.title ? `${page.title} · ${copy.seo.siteName}` : copy.seo.siteName;
const pageDescription = page?.description ?? copy.seo.description;
const currentPath = Astro.url.pathname;
---
<html lang={lang} class="bg-background text-foreground">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background/80 text-foreground">
    <Header lang={lang} copy={copy} currentPath={currentPath} />
    <main class="mx-auto flex w-full max-w-5xl flex-col gap-24 px-6 py-16">
      <slot />
    </main>
    <Footer lang={lang} copy={copy} />
  </body>
</html>
