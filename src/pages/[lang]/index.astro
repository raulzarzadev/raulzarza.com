---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";
import SchemaServices from "../../components/schema/SchemaServices.astro";
import { getCopy, languages, type Lang } from "../../content/site";

export const prerender = true;

interface Props {
  lang: Lang;
}

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as Props;
const copy = getCopy(lang);
---
<BaseLayout lang={lang} copy={copy} page={{ description: copy.seo.description }}>

  <SchemaServices lang={lang} services={copy.services.items} />

  <section class="space-y-6">
    <SectionHeading eyebrow={copy.hero.eyebrow} title={copy.hero.title} caption={copy.hero.description} level="h1" />
    <nav class="grid gap-3 sm:grid-cols-2" aria-label={lang === 'es' ? 'Perfiles principales' : 'Main profiles'}>
      <a
        href="/developer"
        class="group flex min-h-28 flex-col justify-between rounded-3xl bg-primary p-6 text-primary-foreground transition-transform hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <span class="text-xs font-medium uppercase tracking-[0.22em] opacity-70">{lang === 'es' ? 'Perfil profesional' : 'Professional profile'}</span>
        <span class="flex items-end justify-between gap-4 text-2xl font-semibold">
          Developer
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
      <a
        href="/natacion"
        class="group flex min-h-28 flex-col justify-between rounded-3xl border border-border bg-card p-6 transition-transform hover:-translate-y-0.5 hover:border-foreground/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <span class="text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground">{lang === 'es' ? 'Perfil personal' : 'Personal profile'}</span>
        <span class="flex items-end justify-between gap-4 text-2xl font-semibold">
          {lang === 'es' ? 'Natación' : 'Swimming'}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    </nav>
    <div class="flex flex-wrap gap-4">
      {copy.hero.actions.map((action) => (
        <Button href={action.href} variant={action.variant} download={action.download}>
          {action.label}
        </Button>
      ))}
    </div>
  </section>

  <section class="space-y-10">
    <SectionHeading title={copy.projects.title} caption={copy.projects.caption} />
    <div class="grid gap-6 md:grid-cols-2">
      {copy.projects.items.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section class="space-y-10">
    <SectionHeading title={copy.services.title} caption={copy.services.caption} />
    <div class="grid gap-6 md:grid-cols-3">
      {copy.services.items.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>
  </section>

  <section class="space-y-8">
    <SectionHeading title={copy.facets.title} caption={copy.facets.caption} />
    <div class="space-y-6">
      {copy.facets.items.map((facet) => (
        <article class="rounded-3xl border border-border/60 p-6">
          <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">{facet.year}</p>
          <h3 class="mt-2 text-lg font-semibold">{facet.title}</h3>
          <p class="text-sm text-muted-foreground">{facet.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="space-y-6 rounded-3xl border border-border/60 p-8">
    <SectionHeading title={copy.contact.title} caption={copy.contact.caption} />
    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-4">
        <p class="text-sm font-medium">{copy.contact.emailLabel}</p>
        <a href={`mailto:${copy.contact.email}`} class="text-2xl font-semibold">{copy.contact.email}</a>
      </div>
      <div class="space-y-4">
        <div class="flex flex-wrap gap-3 text-sm text-muted-foreground">
          {copy.contact.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">
              {social.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
