---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import ProjectCard from "../../../components/cards/ProjectCard.astro";
import { getCopy, languages, type Lang } from "../../../content/site";

export const prerender = true;

interface Props {
  lang: Lang;
}

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as Props;
const copy = getCopy(lang);
---
<BaseLayout
  lang={lang}
  copy={copy}
  page={{ title: lang === "es" ? "Proyectos SaaS y Plataformas Web" : "SaaS Projects & Web Platforms", description: copy.projects.caption }}
>
  <section class="space-y-8">
    <SectionHeading title={copy.projects.title} caption={copy.projects.caption} />
    <div class="grid gap-6 md:grid-cols-2">
      {copy.projects.items.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>
</BaseLayout>
