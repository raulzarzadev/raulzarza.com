---
import recommendations from "../content/ponguinguiola-recommendations.json";
export const prerender = true;
const projects = [
  {
    title: "BajaBlast: procesos de operación",
    label: "Tres años de experiencia",
    image: "/ponguinguiola/bajablast-logo.svg",
    description: "Trabajé tres años en BajaBlast, donde ayudé con el diseño de procesos de operación para actividades de altura: tirolesas, circuitos de obstáculos y escalada. Esta experiencia me acercó a la organización del trabajo en una operación de actividades recreativas.",
    takeaway: "Diseño de procesos de operación para actividades recreativas de altura.",
    href: "https://bajablast.mx/",
    link: "Conocer BajaBlast",
  },
  {
    title: "Lavarenta: digitalización de la operación",
    label: "Experiencia operativa",
    image: "/projects/bajarent-cover.webp",
    description: "En Lavarenta digitalizamos los procesos de rentas, renovaciones, recolección y entrega de equipos. Trabajar de cerca con lavadoras y sus reparaciones también me permitió comprender cómo el diseño, las herramientas y la mano de obra influyen en la vida útil de los productos.",
    takeaway: "Una mirada práctica sobre mantenimiento, reparabilidad y costos de operación.",
    href: "/es/projects/bajarent",
    link: "Conocer Baja Rent",
  },
  {
    title: "Herramientas para tomar decisiones",
    label: "Desarrollo de soluciones",
    image: "/projects/migranja-cover.webp",
    description: "Con Mi Granja he construido una herramienta para organizar información sobre animales, reproducción y salud del hato. Me interesa que las personas puedan aprovechar sus datos para comprender su operación y tomar decisiones con evidencia.",
    takeaway: "Convertir necesidades concretas en herramientas accesibles y útiles.",
    href: "/es/projects/migranja",
    link: "Conocer Mi Granja",
  },
  {
    title: "Deporte y contexto local",
    label: "Vínculo con Baja California Sur",
    image: "/projects/nandapaz-cover.webp",
    description: "Vivo en La Paz desde hace más de seis años. Fui profesor y entrenador de natación durante más de diez años, incluidos dos años en Nelson Vargas. Las aguas abiertas y el triatlón también forman parte de mi historia. De ese vínculo nacieron proyectos digitales como nadamas.app y herramientas para iniciativas deportivas locales.",
    takeaway: "Conocimiento del entorno y experiencia conectando necesidades humanas con tecnología.",
    href: "/es/projects/nadamas",
    link: "Conocer nadamas.app",
  },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Raúl Zarza · Postulación a Ponguinguiola</title>
    <meta name="description" content="Mi experiencia, motivación y propuesta de contribución al Programa de Emprendimientos Circulares de Ponguinguiola A.C., en Baja California Sur." />
    <link rel="canonical" href="https://raulzarza.com/ponguinguiola" />
    <link rel="icon" href="/favicon.svg?v=zarza-2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-tipo.jpg" />
    <meta property="og:title" content="Raúl Zarza · Postulación a Ponguinguiola" />
    <meta property="og:description" content="Procesos, tecnología y negocios al servicio de soluciones sostenibles en Baja California Sur." />
    <meta property="og:image" content="https://raulzarza.com/logo-tipo.jpg" />
    <meta property="og:image:secure_url" content="https://raulzarza.com/logo-tipo.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="462" />
    <meta property="og:image:height" content="505" />
    <meta property="og:image:alt" content="Logo de Raúl Zarza" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Raúl Zarza · Postulación a Ponguinguiola" />
    <meta name="twitter:description" content="Procesos, tecnología y negocios al servicio de soluciones sostenibles en Baja California Sur." />
    <meta name="twitter:image" content="https://raulzarza.com/logo-tipo.jpg" />
    <meta name="twitter:image:alt" content="Logo de Raúl Zarza" />
    <meta property="og:url" content="https://raulzarza.com/ponguinguiola" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="nav wrap">
      <a class="brand" href="/es">Raúl Zarza<span>La Paz, BCS</span></a>
      <a class="nav-link" href="https://wa.me/525543374016" target="_blank" rel="noopener noreferrer">Conversemos <span aria-hidden="true">↗</span></a>
    </header>
    <main id="contenido">
      <section class="hero wrap" aria-labelledby="titulo">
        <p class="eyebrow">Postulación · Ponguinguiola A.C.</p>
        <h1 id="titulo">Hacer que las ideas<br />funcionen <em>y perduren.</em></h1>
        <p class="intro">Soy Raúl Zarza. Combino experiencia en negocios, mejora de procesos y desarrollo de herramientas digitales. Quiero aportar esa mirada al <strong>Programa de Emprendimientos Circulares</strong> en Baja California Sur.</p>
        <div class="actions">
          <a class="button" href="#carta">Leer mi carta de intención <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/ponguinguiola/cv-raul-zarza-ponguinguiola-una-pagina.pdf" download>Descargar CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="context">
          <p><strong>Más de 6 años</strong><span>viviendo en La Paz</span></p>
          <p><strong>Casi una década</strong><span>construyendo y optimizando procesos</span></p>
          <p><strong>Negocios + tecnología</strong><span>una perspectiva práctica</span></p>
        </div>
      </section>

      <section class="experience wrap" aria-labelledby="experiencia">
        <div class="section-heading"><p class="eyebrow">De dónde vengo</p><h2 id="experiencia">Experiencia que puedo aportar.</h2></div>
        <div class="projects">
          {projects.map((project) => (
            <article class="project">
              {project.image ? <img class:list={{ "company-logo": project.image.endsWith(".svg") }} src={project.image} alt={project.image.endsWith(".svg") ? "BajaBlast" : ""} width="1536" height="1024" loading="lazy" decoding="async" /> : <div class="process-art" aria-hidden="true"><span>Observar</span><i>↓</i><span>Organizar</span><i>↓</i><span>Mejorar</span></div>}
              <div class="project-copy">
                <p class="eyebrow">{project.label}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <p class="takeaway">{project.takeaway}</p>
                {project.href && <a class="text-link" href={project.href} target={project.href.startsWith("https://") ? "_blank" : undefined} rel={project.href.startsWith("https://") ? "noopener noreferrer" : undefined}>{project.link} <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="letter-section" aria-labelledby="carta">
        <div class="letter wrap">
          <aside><p class="eyebrow">Mi motivación</p><h2 id="carta">Carta de<br />intención.</h2><p>Postulación a la coordinación del Programa de Emprendimientos Circulares.</p><p>Esta carta está basada en mi historia personal. Puedes leerla completa en <a class="text-link" href="https://medium.com/@raulzarza.dev/acerca-de-m%C3%AD-a4d6382ce5f8" target="_blank" rel="noopener noreferrer">Acerca de mí <span aria-hidden="true">↗</span></a>.</p><button class="text-link" id="print-letter" type="button">Imprimir carta <span aria-hidden="true">↗</span></button></aside>
          <div class="letter-body">
            <p class="salutation">Al equipo de Ponguinguiola A.C.:</p>
            <p>Me interesa postularme a la coordinación del Programa de Emprendimientos Circulares porque encuentro una conexión entre su propósito y las preguntas que han guiado mi trabajo: cómo aprovechar mejor los recursos, cómo hacer que un negocio funcione y cómo construir soluciones que puedan sostenerse en el tiempo.</p>
            <p>Crecí atendiendo la tienda de abarrotes de mis padres. Ahí aprendí el valor del trabajo y también sus límites: el esfuerzo por sí solo no siempre alcanza. Hace falta revisar la operación, ordenar procesos y, en ocasiones, eliminar lo que ya no aporta. Esa experiencia sigue presente en mi forma de abordar los proyectos.</p>
            <p>Trabajé tres años en BajaBlast, donde ayudé con el diseño de procesos de operación para actividades de altura, tirolesas, circuitos de obstáculos y escalada. En Lavarenta participamos en la digitalización de rentas, renovaciones, recolección y entrega de equipos. Son experiencias que me han acercado a las necesidades cotidianas de los negocios y a la importancia de ordenar el trabajo.</p>
            <p>En el negocio de renta de artículos conocí de cerca los retos del mantenimiento y la reparación. Comprendí que la vida útil de un producto depende tanto de sus piezas como de la facilidad para repararlo, las herramientas disponibles y el costo de la mano de obra. Esa experiencia despertó mi interés por la reparabilidad y el aprovechamiento de los recursos.</p>
            <p>Mi principal herramienta ha sido el software. He desarrollado proyectos como nadamas.app, rentayrepara.com, lavarenta.com y migranja.app pensando en ofrecer herramientas accesibles que ayuden a organizar información, facilitar el trabajo y tomar mejores decisiones. Para mí, la tecnología tiene sentido cuando responde a una necesidad concreta y agrega valor a quienes la usan.</p>
            <p>Fui profesor y entrenador de natación durante más de diez años, incluidos dos años en Nelson Vargas. La enseñanza y el entrenamiento han sido una parte importante de mi trayectoria y de mi forma de trabajar con las personas.</p>
            <p>Mi formación también ha contribuido a esta mirada. Estudié parte de Ingeniería Mecánica en la UAM Azcapotzalco y me gradué como licenciado del Tiempo Libre en la UniYMCA en 2015. La física, la ergonomía, la biomecánica y la natación me enseñaron a observar sistemas, comprender cómo funcionan y buscar formas de mejorarlos.</p>
            <p>Vivo en La Paz, Baja California Sur, desde hace más de seis años. Me interesa poner mi experiencia al servicio de iniciativas con impacto en el lugar donde he construido mi vida. Puedo aportar capacidad para comprender necesidades, estructurar procesos, desarrollar herramientas y organizar datos para dar seguimiento al trabajo.</p>
            <p>Me gustaría conversar con ustedes sobre los retos del programa y conocer cómo esta combinación de experiencia operativa y tecnológica podría contribuir a sus proyectos. Me motiva trabajar en soluciones basadas en evidencia, que consideren su impacto ambiental y puedan perdurar.</p>
            <p>Gracias por considerar mi postulación.</p>
            <div class="signature"><strong>Raúl Zarza</strong><span>La Paz, Baja California Sur</span><a href="https://wa.me/525543374016" target="_blank" rel="noopener noreferrer">WhatsApp · +52 55 4337 4016</a></div>
          </div>
        </div>
      </section>

      <section class="contribution wrap" aria-labelledby="aportacion">
        <div class="section-heading"><p class="eyebrow">Cómo abordaría el trabajo</p><h2 id="aportacion">Escuchar, organizar y dar seguimiento.</h2></div>
        <ol class="steps">
          <li><span class="number">01</span><h3>Entender el contexto</h3><p>Escuchar a las personas involucradas, comprender la operación y reconocer los recursos, necesidades y restricciones de cada iniciativa.</p></li>
          <li><span class="number">02</span><h3>Construir un plan útil</h3><p>Traducir los objetivos en actividades, prioridades y responsabilidades claras, con herramientas que faciliten el trabajo cotidiano.</p></li>
          <li><span class="number">03</span><h3>Aprender de los resultados</h3><p>Organizar información, acordar indicadores y revisar lo que funciona para ajustar las soluciones con base en evidencia.</p></li>
        </ol>
      </section>

      <section class="recommendations wrap" aria-labelledby="recomendaciones">
        <div class="section-heading"><p class="eyebrow">Referencias profesionales</p><h2 id="recomendaciones">Cartas de recomendación.</h2></div>
        {recommendations.length > 0 ? <div class="recommendation-list">{recommendations.map((letter: { name: string; role: string; href: string }) => (
          <article class="recommendation"><div><h3>{letter.name}</h3><p>{letter.role}</p></div><a class="text-link" href={letter.href} target="_blank" rel="noopener noreferrer">Leer carta <span aria-hidden="true">↗</span></a><a class="text-link" href={letter.href} download>Descargar PDF</a></article>
        ))}</div> : <p class="recommendations-pending">Las cartas de recomendación están pendientes de incorporar.</p>}
      </section>

      <section class="contact wrap" aria-labelledby="contacto">
        <div><p class="eyebrow">Sigamos la conversación</p><h2 id="contacto">Me gustaría conocer<br />los retos del programa.</h2></div>
        <div class="contact-actions"><a class="button" href="https://wa.me/525543374016" target="_blank" rel="noopener noreferrer">WhatsApp · +52 55 4337 4016 <span aria-hidden="true">↗</span></a><a class="text-link" href="/ponguinguiola/cv-raul-zarza-ponguinguiola-una-pagina.pdf" download>Descargar mi CV</a></div>
      </section>
    </main>
    <footer class="wrap"><span>Raúl Zarza · La Paz, BCS</span><a href="/es">Conocer mi trabajo <span aria-hidden="true">↗</span></a></footer>
    <script>
      document.getElementById("print-letter")?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 2rem; }
  :global(body) { margin: 0; background: #f7f6f0; color: #203c33; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.65; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 3px solid #a36035; outline-offset: 6px; }
  :global(p), :global(h1), :global(h2), :global(h3) { margin: 0; }
  .wrap { max-width: 1120px; margin-inline: auto; padding-inline: 2rem; }
  .skip { position: absolute; top: -5rem; left: 1rem; padding: .75rem; background: white; z-index: 2; }
  .skip:focus { top: 1rem; }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.75rem; border-bottom: 1px solid #203c3326; }
  .brand { font-size: 1.1rem; font-weight: 700; letter-spacing: -.03em; }
  .brand span { display: block; color: #59675f; font-size: .75rem; font-weight: 400; letter-spacing: .03em; }
  .nav-link, .text-link { font-size: .9rem; font-weight: 600; }
  .text-link { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: #203c3355; }
  .hero { padding-block: 5.5rem 3rem; }
  .eyebrow { font-size: .7rem; font-weight: 650; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin-top: 1.5rem; max-width: 950px; font-size: clamp(2.8rem, 6.5vw, 5rem); line-height: 1.08; font-weight: 500; letter-spacing: -.055em; }
  h1 em { color: #94603d; font-family: Georgia, serif; font-weight: 400; }
  .intro { margin-top: 2rem; max-width: 690px; font-size: 1.13rem; color: #4c5f55; }
  .intro strong { font-weight: 600; color: #203c33; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: 1.5rem; padding: .9rem 1.3rem; border-radius: 8px; background: #203c33; color: #fff; font-size: .9rem; font-weight: 600; transition: background .2s; }
  .button:hover { background: #36594b; }
  .context { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; padding-block: 1.75rem; border-block: 1px solid #203c3326; }
  .context strong { display: block; font-size: 1rem; font-weight: 600; }
  .context span { color: #59675f; font-size: .8rem; }
  .experience, .contribution { padding-block: 3.5rem 5rem; }
  .section-heading { margin-bottom: 2rem; }
  h2 { font-size: clamp(1.9rem, 3.5vw, 2.6rem); font-weight: 500; letter-spacing: -.04em; line-height: 1.2; margin-top: .75rem; }
  .projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .project { display: flex; flex-direction: column; border: 1px solid #203c3326; border-radius: 14px; overflow: hidden; background: #fffefa; }
  .project img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; }
  .process-art { aspect-ratio: 4/3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .5rem; background: #e3e8dc; color: #203c33; font-size: 1.4rem; font-weight: 500; }
  .process-art span { padding: .3rem 1.5rem; border: 1px solid #203c3340; border-radius: 6px; }
  .process-art i { font-size: 1rem; font-style: normal; color: #94603d; }
  .recommendations { padding-bottom: 4rem; }
  .recommendations-pending { color: #4c5f55; }
  .recommendation { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; padding-block: 1.5rem; border-top: 1px solid #203c3326; }
  .recommendation > div { flex: 1; min-width: 180px; }
  .recommendation p { font-size: .9rem; color: #4c5f55; }
  .project img.company-logo { object-fit: contain; padding: 2.5rem; background: #fffefa; }
  .project-copy { display: flex; flex-direction: column; flex: 1; gap: 1rem; padding: 1.5rem; }
  .project h3, .steps h3 { font-size: 1.2rem; font-weight: 600; line-height: 1.3; letter-spacing: -.025em; }
  .project p:not(.eyebrow), .steps p { font-size: .9rem; color: #4c5f55; }
  .project .takeaway { border-top: 1px solid #203c3326; padding-top: 1rem; }
  .project .text-link { margin-top: auto; }
  .letter-section { background: #eaece2; padding-block: 4.5rem; }
  .letter { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; }
  .letter aside > p:not(.eyebrow) { margin-block: 1.5rem; font-size: .9rem; max-width: 250px; color: #4c5f55; }
  button { font-family: inherit; cursor: pointer; background: transparent; color: inherit; padding: 0; border: 0; }
  .letter-body { display: flex; flex-direction: column; gap: 1.4rem; font-size: 1rem; color: #364b40; }
  .salutation { font-weight: 600; }
  .signature { display: flex; flex-direction: column; padding-top: 1rem; font-size: .9rem; }
  .signature strong { font-size: 1.1rem; }
  .signature a { text-decoration: underline; text-underline-offset: 4px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .steps li { border-top: 1px solid #203c3344; padding-top: 1rem; }
  .number { display: block; color: #94603d; font-family: Georgia, serif; font-size: 1.8rem; margin-bottom: 1.5rem; }
  .steps p { margin-top: 1rem; }
  .contact { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 3rem; border-block: 1px solid #203c3326; }
  .contact-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  footer { display: flex; justify-content: space-between; gap: 1rem; padding-block: 2rem; font-size: .8rem; color: #59675f; }
  @media (max-width: 760px) {
    .wrap { padding-inline: 1.25rem; }
    .hero { padding-top: 3.5rem; }
    .context { grid-template-columns: 1fr; gap: 1rem; margin-top: 2.5rem; }
    .projects, .steps, .letter { grid-template-columns: 1fr; }
    .letter { gap: 2rem; }
    .letter aside > p:not(.eyebrow) { max-width: none; }
    .project img { aspect-ratio: 16/9; }
    .contact { flex-direction: column; align-items: flex-start; }
    .letter-section { padding-block: 3rem; }
    .experience, .contribution { padding-block: 2rem 3rem; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
  @media print {
    @page { size: A4; margin: 20mm; }
    :global(body) { background: white; color: black; font-size: 11pt; }
    .nav, .hero, .experience, .contribution, .recommendations, .contact, footer, .skip, #print-letter { display: none; }
    .letter-section { background: white; padding: 0; }
    .letter { display: block; padding: 0; }
    .letter aside { margin-bottom: 1.5rem; }
    .letter aside h2 br { display: none; }
    .letter aside > p:not(.eyebrow) { max-width: none; margin-block: .5rem; }
    .letter-body { font-size: 11pt; line-height: 1.55; gap: .9rem; color: black; }
    .signature { break-inside: avoid; }
  }
</style>
